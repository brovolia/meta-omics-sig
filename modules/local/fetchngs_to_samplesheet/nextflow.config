// Defaults for standalone / nf-meta nf-module use. Set here rather than via `params.x ?:
// params.x` in main.nf, which Nextflow's strict parser reports as "access to undefined
// parameter" on the self-read.
params {
    strategy = 'RNA-Seq'
    target   = 'reads'
    prefix   = 'LMO'
    group    = '0'
}
