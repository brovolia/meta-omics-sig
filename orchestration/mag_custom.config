// Every task must load the singularity module itself rather than rely on whatever
// loaded (or didn't) the shell that launched nextflow -- seen directly: a task
// submitted by the metapipeline orchestrator's wrapper (which never does
// `module load singularity`) failed with `env: 'singularity': No such file or
// directory` (exit 127), while the identical pipeline launched from nfcore.sh
// (which does load it first) ran fine. SLURM jobs inherit the submitting
// shell's PATH, so this isn't guaranteed any other way.
process {
    beforeScript = 'module load gcc12-env; module load singularity'
}

// PROKKA's "IS" blast search shells out to GNU parallel, which fails instantly
// (~5s, never an OOM per sacct) because the ccga_cau profile only relies on
// Nextflow's autoMounts (binds the task work dir, nothing else) -- parallel
// needs a writable $HOME inside the container and somewhere under /scratch
// for its own temp files, neither of which autoMounts provides.
// Same bug, same fix already applied in ibd_catarina/work.config.
process {
    withName: 'PROKKA' {
        containerOptions = { "--home ${task.workDir} -B /scratch/SlurmTMP" }
        errorStrategy = { task.exitStatus in ([2] + (130..145) + [104] + (175..177)) ? 'retry' : 'finish' }
        maxRetries    = 2
        memory        = { 8.GB * task.attempt }
    }
}

// ccga_cau.config advertises max_time/resourceLimits.time = 120.h, but the actual
// SLURM partitions on this cluster (base, highmem, gpu) all cap at 48h (MaxTime
// 2-00:00:00; confirmed via `sinfo`). METASPADES/METASPADESHYBRID retry with an
// exponential time backoff (24h * 2^(attempt-1)) that blows past 48h on attempt 3
// (96h) while still staying under the stale 120h ceiling, so Nextflow never clamps
// it and `sbatch` rejects the submission outright ("Requested time limit is
// invalid"), burning through all retries in seconds and aborting the run. Clamp
// here to the real partition limit until ccga_cau.config itself is fixed upstream.
process {
    resourceLimits = [time: 48.h]
}
params {
    max_time = 48.h
}
