// Glue steps here are run via `nextflow run <this repo> -main-script modules/local/<x>/main.nf`
// (see orchestration/README.md -- "a wrong turn, corrected"), and nf-meta's `nf-pipeline`
// steps always get `-profile` wired in from the chain's `globals.profile` (currently
// `ccga_cau`). Without this file that profile name is unknown here -- this repo has no
// nextflow.config at all, unlike the real nf-core pipelines in the chain, whose own
// nextflow.config pulls in nf-core/configs' institutional profiles the same way. Mirror
// that so glue steps can use the same -profile as every other step in the chain.
params {
    custom_config_version = 'master'
    custom_config_base    = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
}

includeConfig params.custom_config_base && !System.getenv('NXF_OFFLINE') ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"
